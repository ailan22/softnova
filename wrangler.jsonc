{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softnova",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_EMAIL": "softnova.contacto@gmail.com",
    "FROM_EMAIL": "formulario@softnova.uy"
  },
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "softnova.contacto@gmail.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
